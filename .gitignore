# Your local settings (copy kit.config.example.yaml to create it).
/kit.config.yaml

# Runner state: logs and the local backlog stay on your machine.
/runner/logs/
/runner/backlog/

# Environment files hold secrets; never commit them.
*.env
.env

# The sb scan key lives in ~/.config/grok-kit/, outside every repo; a stray
# copy is never committed either.
scan.key

# Your private business profile (AGENTS.md checkpoint 3b) never goes into git
# or a public fork: no private/ folder and no business-profile*.yaml anywhere.
# `python3 tools/business_profile.py check` refuses a commit that holds one.
private/
business-profile*.yaml
business-profile*.yml

# Python caches.
__pycache__/
*.pyc
