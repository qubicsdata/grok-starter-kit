#!/usr/bin/env python3
"""Fake `claude` for router tests. Records argv + which sensitive env names are present (never values)."""
import json, os, sys
argv = sys.argv[1:]
rec = os.environ.get("FAKE_CLAUDE_RECORD")
watch = ["GH_TOKEN", "GITHUB_TOKEN", "NPM_TOKEN", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN",
         "OPENAI_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY", "CLAUDE_CODE_SUBAGENT_MODEL"]
if rec:
    with open(rec, "a") as f:
        f.write(json.dumps({"argv": argv, "env_present": {k: k in os.environ for k in watch},
                            "subagent_model": os.environ.get("CLAUDE_CODE_SUBAGENT_MODEL"),
                            "claude_env_file": os.environ.get("CLAUDE_ENV_FILE"),
                            "stdin_isatty": sys.stdin.isatty(), "cwd": os.getcwd()}) + "\n")
def opt(name, default=None):
    return argv[argv.index(name) + 1] if name in argv else default
model = opt("--model") or "default"
full = {"opus": "claude-opus-5-5", "opusplan": "claude-sonnet-5-5", "sonnet": "claude-sonnet-5-5",
        "haiku": "claude-haiku-5-5", "default": "claude-opus-5-5"}.get(model, model)
mode = os.environ.get("FAKE_CLAUDE_MODE", "ok")
mu = {full: {"inputTokens": 10, "outputTokens": 20, "cacheReadInputTokens": 30, "cacheCreationInputTokens": 40, "costUSD": 0.01}}
res = {"type": "result", "subtype": "success", "is_error": False, "result": "OK", "session_id": "fake-session",
       "num_turns": 1, "duration_ms": 5, "api_error_status": None, "modelUsage": mu}
reset5, reset7 = int(os.environ.get("FAKE_RESET5", "1792075800")), int(os.environ.get("FAKE_RESET7", "1792162800"))
status = "allowed"
if mode == "ratelimit":
    status = "rejected"
    res.update({"is_error": True, "subtype": "error_during_execution", "result": "You've hit your limit · resets 5:50pm", "api_error_status": 429})
ev = {"type": "rate_limit_event", "rate_limit_info": {"status": status, "resetsAt": reset5, "rateLimitType": "five_hour",
      "unifiedWindows": {"five_hour": {"utilization": 1.0 if mode == "ratelimit" else 0.42, "resetsAt": reset5},
                         "seven_day": {"utilization": 0.31, "resetsAt": reset7}}}, "uuid": "u", "session_id": "fake-session"}
if opt("--output-format") == "stream-json":
    print(json.dumps({"type": "system", "subtype": "init", "model": full}))
    print(json.dumps(ev)); print(json.dumps(ev))  # duplicate -> must be deduplicated
    print(json.dumps(res, separators=(",", ":")))
else:
    print(json.dumps(res, separators=(",", ":")))
sys.exit(int(os.environ.get("FAKE_CLAUDE_RC", "0")))
